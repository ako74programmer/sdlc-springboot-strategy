{
  "servers": {
    "erste-intranet-mcp": {
      "type": "stdio",
      "command": "npm",
      "cwd": "${env:ERSTE_INTRANET_MCP_SERVER_PROJECT_ROOT}",
      "args": [
        "run",
        "start"
      ],
      "env": {
        "ERSTE_INTRANET_MCP_SERVER_PROJECT_ROOT": "${env:ERSTE_INTRANET_MCP_SERVER_PROJECT_ROOT}",
        "ERSTE_INTRANET_MCP_SERVER_JIRA_URL": "https://godzilla.centrala.bzwbk:9999",
        "ERSTE_INTRANET_MCP_SERVER_JIRA_USER": "${env:ERSTE_INTRANET_MCP_SERVER_JIRA_USER}",
        "ERSTE_INTRANET_MCP_SERVER_JIRA_TOKEN": "${env:ERSTE_INTRANET_MCP_SERVER_JIRA_TOKEN}",
        "ERSTE_INTRANET_MCP_SERVER_JIRA_AUTH_MODE": "bearer",
        "ERSTE_INTRANET_MCP_SERVER_CONFLUENCE_URL": "https://orsite.centrala.bzwbk",
        "ERSTE_INTRANET_MCP_SERVER_CONFLUENCE_USER": "${env:ERSTE_INTRANET_MCP_SERVER_CONFLUENCE_USER}",
        "ERSTE_INTRANET_MCP_SERVER_CONFLUENCE_TOKEN": "${env:ERSTE_INTRANET_MCP_SERVER_CONFLUENCE_TOKEN}",
        "ERSTE_INTRANET_MCP_SERVER_CONFLUENCE_AUTH_MODE": "bearer",
        "ERSTE_INTRANET_MCP_SERVER_WRITE_ENABLED": "false",
        "ERSTE_INTRANET_MCP_SERVER_ENABLE_JIRA": "true",
        "ERSTE_INTRANET_MCP_SERVER_ENABLE_CONFLUENCE": "true",
        "ERSTE_INTRANET_MCP_SERVER_ENABLE_COMMON": "true",
        "ERSTE_INTRANET_MCP_SERVER_ENABLE_GITLAB": "false",
        "ERSTE_INTRANET_MCP_SERVER_ENABLE_SONAR": "false",
        "ERSTE_INTRANET_MCP_SERVER_ENABLE_SAN_UI": "false",
        "ERSTE_INTRANET_MCP_SERVER_ENABLE_REVIEW": "false",
        "ERSTE_INTRANET_MCP_SERVER_ENABLE_SETUP": "false",
        "ERSTE_INTRANET_MCP_SERVER_ENABLE_WATCHDOG": "false",
        "ERSTE_INTRANET_MCP_SERVER_ENABLE_KNOWLEDGE": "false",
        "ERSTE_INTRANET_MCP_SERVER_ENABLE_BP": "false",
        "ERSTE_INTRANET_MCP_SERVER_ENABLE_QA": "false",
        "ERSTE_INTRANET_MCP_SERVER_ENABLE_DEVTOOLS": "false",
        "NODE_OPTIONS": "--use-system-ca --tls-min-v1.2"
      }
    }
  }
}
